{
  "name": "readyrig-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run sync:brand && vite --host 127.0.0.1",
    "build": "npm run sync:brand && npm run check && vite build",
    "check": "tsc --noEmit",
